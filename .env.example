# URL the MCP server uses to reach ComfyUI
COMFYUI_URL=http://192.168.0.10:8188
# URL shown in returned links (optional; defaults to COMFYUI_URL)
# COMFYUI_PUBLIC_URL=https://comfy.mydomain.com
# Bearer token for ComfyUI behind an authenticating proxy (optional)
# COMFYUI_API_KEY=

WORKFLOWS_DIR=./workflows
WORKFLOWS_FROM_COMFYUI=true
DEFAULT_WAIT_TIMEOUT=300
PREVIEW_MAX_SIZE=768

# stdio (local clients) or http (Docker/Kubernetes)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
# External URL of this MCP server (HTTP mode): enables /media, i.e. output links that are
# streamed through the MCP (seekable), signed, expiring, with a /player page.
# MCP_PUBLIC_URL=https://dreamer-mcp.mydomain.com
# MEDIA_SECRET=            (defaults to a key derived from MCP_AUTH_TOKEN)
# MEDIA_LINK_TTL=86400
# Required Authorization: Bearer <token> in HTTP mode (recommended)
# MCP_AUTH_TOKEN=
LOG_LEVEL=INFO
